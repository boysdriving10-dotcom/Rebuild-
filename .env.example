# BallOut — Supabase (public client credentials only)
# Copy this file to `.env` and fill in values from your EXISTING Supabase project:
#   Dashboard → Project Settings → API
#
# EXPO_PUBLIC_SUPABASE_URL          = Project URL
# EXPO_PUBLIC_SUPABASE_ANON_KEY     = anon / public (publishable) key
#
# Never put the service_role / secret key in this app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
